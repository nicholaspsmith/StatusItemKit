#!/usr/bin/env bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# Copyright (c) 2026 Nicholas Smith

# Menumon pre-push: refuse a push that does not carry a release. Installed per
# app repo by scripts/release/adopt.sh (core.hooksPath, local to that repo).
#
#   branch push   the tip's CHANGELOG.md opens with a new, dated, untagged
#                 version (check-release.sh), unless the tip commit message
#                 says [no release]
#   vX.Y.Z tag    CHANGELOG.md at that commit has its section
#
# The GitHub workflow enforces the same rule on main and does the tagging, so
# this is the early warning, not the only guard. `git push --no-verify` skips it.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
check="$here/../check-release.sh"
zero=0000000000000000000000000000000000000000

# Compare against the real tag list, not a stale local one.
GIT_TERMINAL_PROMPT=0 git fetch --quiet --tags "$1" 2>/dev/null || true

input="$(cat)"
status=0
while read -r local_ref local_sha remote_ref _; do
    [ "$local_sha" = "$zero" ] && continue          # a deletion
    case "$remote_ref" in
        refs/tags/v*)
            # Tags from before the app kept a changelog are history, not releases to check.
            git cat-file -e "$local_sha:CHANGELOG.md" 2>/dev/null || continue
            "$check" "$local_sha" --tag "${remote_ref#refs/tags/}" >/dev/null || status=1 ;;
        refs/heads/*)
            if git log -1 --format=%B "$local_sha" | grep -qF '[no release]'; then
                echo "Menumon: ${remote_ref#refs/heads/} pushed without a release ([no release])." >&2
                continue
            fi
            version="$("$check" "$local_sha")" || { status=1; continue; }
            echo "Menumon: ${remote_ref#refs/heads/} carries v$version — GitHub tags it when it reaches main." >&2 ;;
    esac
done <<<"$input"

# Chain to a repo's own hook, since core.hooksPath hides .git/hooks.
if [ $status -eq 0 ] && [ -x "$(git rev-parse --git-common-dir)/hooks/pre-push" ]; then
    exec "$(git rev-parse --git-common-dir)/hooks/pre-push" "$@" <<<"$input"
fi
exit $status
